{
  "enabled": true,
  "hoverFocus": true,
  "expandMode": "near",
  "widthMultiplier": 0.85,
  "heightMultiplier": 0.85,
  "collapseSize": 57,
  "hoverDelay": 120,
  "fullscreenDelay": 5000,
  "includeFloating": false,
  "stickyFullscreen": false,
  "mouseRefocus": false,
  "animate": true,
  "animateSpeed": 0,
  "columns": {
